{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "module": "CommonJS",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "scripts"]
}
